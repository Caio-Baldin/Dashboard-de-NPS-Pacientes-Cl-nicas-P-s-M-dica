# Copie este arquivo para ".env" (nunca commitar o .env real) e preencha com
# a mesma conta Indecx usada para exportar a pesquisa de NPS de paciente
# manualmente (login/senha da tela do Indecx + a "frontend-access-key" --
# ver README/PROGRESSO para como capturar essa última via DevTools).

INDECX_EMAIL=
INDECX_SENHA=
INDECX_FRONTEND_ACCESS_KEY=

# ConsultaJá (base de agendamentos, usada pelo card "Engajamento"). Preencha
# com o token fornecido pela ConsultaJá -- ele dá acesso a dado de paciente
# (nome, celular), então nunca commite o .env real nem compartilhe este token.
CONSULTAJA_TOKEN=
# Opcionais -- se vazio, fetch_consultaja.py busca o histórico completo.
CONSULTAJA_START_DATE=
CONSULTAJA_END_DATE=
